# LingoVoice AI Server Environment Configuration

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB URI (leave empty or set to mongodb://localhost:27017/lingovoice to use local or auto in-memory fallback)
MONGO_URI=mongodb://localhost:27017/lingovoice

# JWT Secret for Session Authentication
JWT_SECRET=lingovoice_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# AI Provider API Keys (Optional - deterministic intelligent fallback will run if keys are absent)
# OpenRouter API Key (Primary AI Provider)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Google Gemini API Key (Fallback AI Provider)
GEMINI_API_KEY=

# Voice / TTS Settings
DEFAULT_VOICE_LANGUAGE=en-US
